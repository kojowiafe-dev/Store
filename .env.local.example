# ==============================================================================
# Campus Store — Local Environment Configuration Template
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Supabase Public Keys (Client & Server-safe)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER expose to client, NEVER use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Campus & Pilot Topology Configuration
NEXT_PUBLIC_CAMPUS_NAME="University of Ghana"
NEXT_PUBLIC_DEFAULT_HALL_SLUG="jean-nelson-aka-hall"
NEXT_PUBLIC_PLATFORM_NAME="Campus Store"

